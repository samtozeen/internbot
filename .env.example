# Copy to .env and fill in
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata
# Public HTTPS URL that forwards to n8n (needed for the Telegram webhook)
# e.g. your Railway domain or an ngrok static domain
WEBHOOK_URL=https://your-public-domain.example/
# API keys are NOT set here - add them as n8n credentials (see README)
